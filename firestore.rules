rules_version = '2';

// ============================================================
//  Meeting Ledger — security rules
//
//  IMPORTANT: edit emailPattern() below with your real domain,
//  then paste the whole file into
//  Firebase Console -> Firestore Database -> Rules -> Publish.
//
//  These rules are the ONLY thing protecting your data. The app's
//  screens just hide things; the rules actually enforce them.
//
//  Roles, five tiers:
//    superadmin — sees everything, and is the ONLY role that can add
//                 people, change anyone's role, or remove access.
//    admin      — sees everything (Master, every meeting, the team
//                 roster), can log their own meetings, but cannot add,
//                 edit, or remove anyone.
//    teamlead   — sees Master, contacts, and leads for themselves PLUS
//                 anyone whose `managedBy` field points to them — never
//                 the whole company. Cannot manage the team.
//    observer   — sees Master and the team roster, can download the
//                 exports, but cannot log a meeting, edit anything, or
//                 touch the team list. Pure view + download, nothing else.
//    rm         — sees and logs only their own meetings.
//
//  Two extra collections beyond meetings/plans/users:
//    contacts — the Wealth Manager / Channel Partner registry. RM sees own,
//               Team Lead sees own + reports', everyone else (including
//               Observer) sees all.
//    leads    — people a contact has introduced. RM sees own, Team Lead
//               sees own + reports', Admin and Superadmin see all,
//               Observer sees NONE.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // EDIT THIS ONE LINE. Escape the dots as [.] — it is a regex.
    function emailPattern() {
      return '^[^@]+@hyperioncapital[.]in$';
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Signed in, inbox confirmed, and on our domain.
    function onDomain() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && callerEmail().matches(emailPattern());
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(callerEmail())).data;
    }

    // On the domain AND on the team list AND not switched off.
    function isMember() {
      return onDomain()
        && exists(/databases/$(database)/documents/users/$(callerEmail()))
        && profile().active == true;
    }

    function isSuperAdmin() {
      return isMember() && profile().role == 'superadmin';
    }

    // Admin or Superadmin — both see every meeting, the funnel, and the
    // team roster, and both can log their own meetings. Only Superadmin
    // can WRITE to the team roster.
    function isAdminOrAbove() {
      return isMember() && profile().role in ['admin', 'superadmin'];
    }

    function isObserver() {
      return isMember() && profile().role == 'observer';
    }

    function isTeamLead() {
      return isMember() && profile().role == 'teamlead';
    }

    // Looks up the TARGET person's own profile (not the caller's) to check
    // whether they report to whoever's asking. One extra document read,
    // same pattern as profile() above — standard and cheap at this scale.
    function isMyReport(email) {
      return email != null
        && exists(/databases/$(database)/documents/users/$(email))
        && get(/databases/$(database)/documents/users/$(email)).data.managedBy == callerEmail();
    }

    // Everyone who sees Master + the team roster: Admin, Superadmin, and
    // Observer. Observer stops there — no logging, no editing.
    function canViewAll() {
      return isAdminOrAbove() || isObserver();
    }

    // Only roles that are actually allowed to log a meeting or a plan.
    // Observer is deliberately excluded — view + download only.
    function canLog() {
      return isMember() && profile().role in ['rm', 'admin', 'superadmin', 'teamlead'];
    }

    // ---------- the team list ----------
    // Everyone reads only their own entry. Admin, Superadmin, and
    // Observer read all, for the roster (names, designations) that
    // reports and the Team tab are built from.
    // Only Superadmin may create, edit, or remove anyone — including
    // other Admins. Nobody else has write access here at all.
    match /users/{email} {
      allow get:  if canViewAll()
        || (onDomain() && callerEmail() == email)
        || (isTeamLead() && resource.data.managedBy == callerEmail());
      allow list: if canViewAll()
        || (isTeamLead() && resource.data.managedBy == callerEmail());
      allow write: if isSuperAdmin();
    }

    // ---------- meetings ----------
    // Document ID is deterministic: `${date}_${10-digit phone}`. This is
    // what blocks duplicates — the SAME phone number on the SAME date
    // always resolves to the SAME document, so a second attempt by a
    // different person is rejected outright by the update rule below
    // (their rmEmail won't match the existing owner). A second attempt
    // by the SAME person is treated as a correction, not a duplicate.
    //
    // An RM only ever touches rows carrying their own email.
    // Admin and Superadmin see and edit everything. Observer sees
    // everything too, but can never create, update, or delete a row.
    match /meetings/{meetingId} {
      allow get, list: if canViewAll()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.date is string
        && request.resource.data.prospectName is string
        && request.resource.data.prospectName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && meetingId == request.resource.data.date + '_' + request.resource.data.phone;

      allow update: if isAdminOrAbove()
        || (canLog()
            && resource.data.rmEmail == callerEmail()
            && request.resource.data.rmEmail == callerEmail());

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // ---------- next-day plans ----------
    // Document ID: `${rmEmail}_${planDate}` — one plan per person per day.
    // Anyone who can log meetings can write their own plan. Admin,
    // Superadmin, and Observer read all, for Plan vs Achievement; an RM
    // reads only their own. Observer never writes a plan of their own.
    match /plans/{planId} {
      allow get, list: if canViewAll()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create, update: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.plannedCount is int
        && request.resource.data.plannedCount >= 0
        && planId == callerEmail() + '_' + request.resource.data.planDate;

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // ---------- contacts: Wealth Manager / Channel Partner registry ----------
    // Document ID is deterministic: `WM-<phone>` or `CP-<phone>`. Same trick
    // as meetings — a second RM trying to register the same phone number
    // hits an existing document they don't own, and the update rule below
    // rejects it. That's the entire duplicate-contact defence; no extra
    // logic needed.
    //
    // RM sees only contacts they created. Admin, Superadmin, AND Observer
    // see everyone's — this registry is considered less sensitive than the
    // actual leads a contact has introduced (see /leads below).
    // Only Superadmin may transfer a contact to a different owner or edit
    // one that isn't theirs; the creating RM/Admin may fix their own.
    match /contacts/{contactId} {
      allow get:  if canViewAll()
        || (isMember() && resource.data.createdByEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.createdByEmail));
      allow list: if canViewAll()
        || (isMember() && resource.data.createdByEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.createdByEmail));

      allow create: if canLog()
        && request.resource.data.createdByEmail == callerEmail()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() == 10;

      allow update: if isSuperAdmin()
        || (isMember() && resource.data.createdByEmail == callerEmail());

      allow delete: if isSuperAdmin();
    }

    // ---------- leads: people a Wealth Manager / Channel Partner introduced ----------
    // Document ID: `<meetingId>_<lead phone>` — one doc per lead per meeting,
    // rewritten in place if the same lead is edited on that meeting later.
    //
    // Deliberately a SEPARATE collection from meetings, not a field inside
    // one. Firestore rules can only allow or deny a whole document, not one
    // field within it — splitting leads out is what makes it possible for
    // Observer to see a meeting's summary on Master while never being able
    // to read the leads tied to it. RM sees only their own; Admin and
    // Superadmin see everyone's; Observer has no access here at all.
    match /leads/{leadId} {
      allow get, list: if isAdminOrAbove()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.leadName is string
        && request.resource.data.leadName.size() > 0
        && request.resource.data.leadPhone is string
        && request.resource.data.leadPhone.size() == 10
        && request.resource.data.leadDate is string;

      allow update: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
