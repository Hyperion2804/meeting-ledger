rules_version = '2';

// ============================================================
//  Meeting Ledger — security rules
//
//  IMPORTANT: edit emailPattern() below with your real domain,
//  then paste the whole file into
//  Firebase Console -> Firestore Database -> Rules -> Publish.
//
//  These rules are the ONLY thing protecting your data. The app's
//  screens just hide things; the rules actually enforce them.
//
//  Roles, five tiers:
//    superadmin — sees everything, and is the ONLY role that can add
//                 people, change anyone's role, or remove access.
//    admin      — sees everything (Master, every meeting, the team
//                 roster), can log their own meetings, but cannot add,
//                 edit, or remove anyone.
//    teamlead   — sees Master, contacts, and leads for themselves PLUS
//                 anyone whose `managedBy` field points to them — never
//                 the whole company. Cannot manage the team.
//    observer   — sees Master and the team roster, can download the
//                 exports, but cannot log a meeting, edit anything, or
//                 touch the team list. Pure view + download, nothing else.
//    rm         — sees and logs only their own meetings.
//
//  Two extra collections beyond meetings/plans/users:
//    contacts — the Wealth Manager / Channel Partner registry. RM sees own,
//               Team Lead sees own + reports', everyone else (including
//               Observer) sees all.
//    leads    — people a contact has introduced. RM sees own, Team Lead
//               sees own + reports', Admin and Superadmin see all,
//               Observer sees NONE.
//    weeklyPlans — who someone intends to meet, before it happens. Same
//               visibility as meetings: RM own, Team Lead own + reports',
//               everyone else (including Observer) sees all.
//    weekAgendas — the weekly planner: non-meeting work for a week, no
//               fixed day. Same rules as weeklyPlans, except Observer
//               can't read it at all.
//    dayTasks   — a Superadmin's private task list, used by the Hyperion
//               Calendar app. Only the owning Superadmin can read or
//               write; nobody else, at all.
//    holidays   — the firm's holiday list, one doc per date (doc ID =
//               YYYY-MM-DD), managed in Hyperion Calendar → Holidays.
//               Every member reads (Meeting Ledger uses it for RMs and
//               Team Leads too); only a Superadmin adds, renames or removes. Office
//               timings themselves are fixed in each app's config.js.
//    calEvents  — Hyperion Calendar: busy blocks, leave, out of office,
//               WFH. All Admins/Superadmins read; owner writes.
//    travelPlans — a trip filed for approval. Same visibility shape.
//               Approval: Team Lead approves their own reports; Admin
//               and Superadmin approve each other and everyone else —
//               that cross-approval is also what covers a Team Lead's
//               own plan (they have no manager of their own) and anyone
//               whose managedBy isn't set yet.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // EDIT THIS ONE LINE. Escape the dots as [.] — it is a regex.
    function emailPattern() {
      return '^[^@]+@hyperioncapital[.]in$';
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Signed in, inbox confirmed, and on our domain.
    function onDomain() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && callerEmail().matches(emailPattern());
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(callerEmail())).data;
    }

    // On the domain AND on the team list AND not switched off.
    function isMember() {
      return onDomain()
        && exists(/databases/$(database)/documents/users/$(callerEmail()))
        && profile().active == true;
    }

    function isSuperAdmin() {
      return isMember() && profile().role == 'superadmin';
    }

    // Admin or Superadmin — both see every meeting, the funnel, and the
    // team roster, and both can log their own meetings. Only Superadmin
    // can WRITE to the team roster.
    function isAdminOrAbove() {
      return isMember() && profile().role in ['admin', 'superadmin'];
    }

    function isObserver() {
      return isMember() && profile().role == 'observer';
    }

    function isTeamLead() {
      return isMember() && profile().role == 'teamlead';
    }

    // Looks up the TARGET person's own profile (not the caller's) to check
    // whether they report to whoever's asking. One extra document read,
    // same pattern as profile() above — standard and cheap at this scale.
    function isMyReport(email) {
      return email != null
        && exists(/databases/$(database)/documents/users/$(email))
        && get(/databases/$(database)/documents/users/$(email)).data.managedBy == callerEmail();
    }

    // Everyone who sees Master + the team roster: Admin, Superadmin, and
    // Observer. Observer stops there — no logging, no editing.
    function canViewAll() {
      return isAdminOrAbove() || isObserver();
    }

    // Only roles that are actually allowed to log a meeting or a plan.
    // Observer is deliberately excluded — view + download only.
    function canLog() {
      return isMember() && profile().role in ['rm', 'admin', 'superadmin', 'teamlead'];
    }

    // ---------- the team list ----------
    // Everyone reads only their own entry. Admin, Superadmin, and
    // Observer read all, for the roster (names, designations) that
    // reports and the Team tab are built from.
    // Only Superadmin may create, edit, or remove anyone — including
    // other Admins. Nobody else has write access here at all.
    match /users/{email} {
      allow get:  if canViewAll()
        || (onDomain() && callerEmail() == email)
        || (isTeamLead() && resource.data.managedBy == callerEmail());
      // Any member can list the team — needed for "Going with" on a
      // planned meeting. Writes stay Superadmin-only.
      allow list: if isMember();
      allow write: if isSuperAdmin();
    }

    // ---------- meetings ----------
    // Document ID is deterministic: `${date}_${10-digit phone}`. This is
    // what blocks duplicates — the SAME phone number on the SAME date
    // always resolves to the SAME document, so a second attempt by a
    // different person is rejected outright by the update rule below
    // (their rmEmail won't match the existing owner). A second attempt
    // by the SAME person is treated as a correction, not a duplicate.
    //
    // An RM only ever touches rows carrying their own email.
    // Admin and Superadmin see and edit everything. Observer sees
    // everything too, but can never create, update, or delete a row.
    match /meetings/{meetingId} {
      allow get, list: if canViewAll()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.date is string
        && request.resource.data.prospectName is string
        && request.resource.data.prospectName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && meetingId == request.resource.data.date + '_' + request.resource.data.phone;

      allow update: if isAdminOrAbove()
        || (canLog()
            && resource.data.rmEmail == callerEmail()
            && request.resource.data.rmEmail == callerEmail());

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // ---------- next-day plans ----------
    // Document ID: `${rmEmail}_${planDate}` — one plan per person per day.
    // Anyone who can log meetings can write their own plan. Admin,
    // Superadmin, and Observer read all, for Plan vs Achievement; an RM
    // reads only their own. Observer never writes a plan of their own.
    match /plans/{planId} {
      allow get, list: if canViewAll()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create, update: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.plannedCount is int
        && request.resource.data.plannedCount >= 0
        && planId == callerEmail() + '_' + request.resource.data.planDate;

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // ---------- contacts: Wealth Manager / Channel Partner registry ----------
    // Document ID is deterministic: `WM-<phone>` or `CP-<phone>`. Same trick
    // as meetings — a second RM trying to register the same phone number
    // hits an existing document they don't own, and the update rule below
    // rejects it. That's the entire duplicate-contact defence; no extra
    // logic needed.
    //
    // RM sees only contacts they created. Admin, Superadmin, AND Observer
    // see everyone's — this registry is considered less sensitive than the
    // actual leads a contact has introduced (see /leads below).
    // Only Superadmin may transfer a contact to a different owner or edit
    // one that isn't theirs; the creating RM/Admin may fix their own.
    match /contacts/{contactId} {
      allow get:  if canViewAll()
        || (isMember() && resource.data.createdByEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.createdByEmail));
      allow list: if canViewAll()
        || (isMember() && resource.data.createdByEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.createdByEmail));

      allow create: if canLog()
        && request.resource.data.createdByEmail == callerEmail()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() == 10;

      allow update: if isSuperAdmin()
        || (isMember() && resource.data.createdByEmail == callerEmail());

      allow delete: if isSuperAdmin();
    }

    // ---------- leads: people a Wealth Manager / Channel Partner introduced ----------
    // Document ID: `<meetingId>_<lead phone>` — one doc per lead per meeting,
    // rewritten in place if the same lead is edited on that meeting later.
    //
    // Deliberately a SEPARATE collection from meetings, not a field inside
    // one. Firestore rules can only allow or deny a whole document, not one
    // field within it — splitting leads out is what makes it possible for
    // Observer to see a meeting's summary on Master while never being able
    // to read the leads tied to it. RM sees only their own; Admin and
    // Superadmin see everyone's; Observer has no access here at all.
    match /leads/{leadId} {
      allow get, list: if isAdminOrAbove()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.leadName is string
        && request.resource.data.leadName.size() > 0
        && request.resource.data.leadPhone is string
        && request.resource.data.leadPhone.size() == 10
        && request.resource.data.leadDate is string;

      allow update: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // ---------- weeklyPlans: who a person intends to meet, before it happens ----------
    // A lightweight planning aid, separate from the numeric daily plan in
    // /plans. Same visibility shape as meetings — RM sees own, Team Lead
    // sees own + reports, Admin/Superadmin/Observer see everyone's.
    match /weeklyPlans/{planId} {
      allow get, list: if canViewAll()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail))
        || (isMember() && callerEmail() in resource.data.companionEmails);   // going along

      // A plan has either a confirmed day (date) or, with the day still to
      // be confirmed, an empty date plus the Monday of its week (weekStart).
      allow create: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.date is string
        && (request.resource.data.date.size() == 10
            || (request.resource.data.get('weekStart', '') is string
                && request.resource.data.get('weekStart', '').size() == 10))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.personType is string
        && request.resource.data.personType.size() > 0;

      allow update: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail() && request.resource.data.rmEmail == callerEmail());

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // ---------- dayTasks: a Superadmin's private task list (Calendar app) ----------
    // Strictly private: only the Superadmin who owns a task can read or
    // write it. No Admin override, no other Superadmin, no Observer.
    // Owner is stamped as ownerEmail and can never be changed.
    match /dayTasks/{taskId} {
      allow get, list: if isSuperAdmin() && resource.data.ownerEmail == callerEmail();

      allow create: if isSuperAdmin()
        && request.resource.data.ownerEmail == callerEmail()
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.status in ['Open', 'Done'];

      allow update: if isSuperAdmin()
        && resource.data.ownerEmail == callerEmail()
        && request.resource.data.ownerEmail == callerEmail();

      allow delete: if isSuperAdmin() && resource.data.ownerEmail == callerEmail();
    }

    // ---------- holidays: the firm-wide holiday list ----------
    // Doc ID is the date itself, so a date can only be listed once.
    // Managed in Hyperion Calendar → Holidays. Everyone on the team reads it
    // (Meeting Ledger marks these days off for every role); only a
    // Superadmin writes.
    match /holidays/{day} {
      allow get, list: if isMember();
      allow create, update: if isSuperAdmin()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date == day
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow delete: if isSuperAdmin();
    }

    // ==================== HYPERION CALENDAR (separate app, same project) ====================
    // The calendar app shares this Firebase project so it can show Meeting
    // Ledger data (meetings, scheduled meetings, travel) without copying it.
    // Only Admins and Superadmins can use it. Everything below is readable
    // by every Admin/Superadmin (so they see each other's week) and
    // writable only by its owner. Tasks (dayTasks, above) stay private.

    // A calendar event is valid when its shape is right: a known kind, a
    // date range that runs forwards, and HH:MM times when it isn't all-day.
    function calEventValid(d) {
      return d.kind in ['busy', 'leave', 'ooo', 'wfh']
        && d.title is string && d.title.size() <= 200
        && d.date is string && d.date.size() == 10
        && d.endDate is string && d.endDate.size() == 10
        && d.endDate >= d.date
        && d.allDay is bool
        && (d.allDay == true
            || (d.start is string && d.start.size() == 5
                && d.end is string && d.end.size() == 5
                && d.end > d.start
                && d.endDate == d.date));
    }

    // (calProfiles — per-person office timings — is retired: the firm has
    // one schedule now. Any old calProfiles docs fall to the deny-all below.)

    // ---------- calEvents: busy blocks, leave, out of office, WFH ----------
    match /calEvents/{eventId} {
      allow get, list: if isAdminOrAbove();
      allow create: if isAdminOrAbove()
        && request.resource.data.ownerEmail == callerEmail()
        && calEventValid(request.resource.data);
      allow update: if isAdminOrAbove()
        && resource.data.ownerEmail == callerEmail()
        && request.resource.data.ownerEmail == callerEmail()
        && calEventValid(request.resource.data);
      allow delete: if isAdminOrAbove() && resource.data.ownerEmail == callerEmail();
    }

    // ---------- weekAgendas: the weekly planner (non-meeting work) ----------
    // One doc per item, keyed to the Monday of its week. Mirrors
    // weeklyPlans EXCEPT reads: Observer is excluded entirely (isAdminOrAbove
    // instead of canViewAll) — the planner is internal working notes, same
    // reasoning as /leads. Only the create-time field checks also differ.
    match /weekAgendas/{itemId} {
      allow get, list: if isAdminOrAbove()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.weekStart is string
        && request.resource.data.weekStart.size() == 10
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.status in ['Open', 'Done'];

      allow update: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail() && request.resource.data.rmEmail == callerEmail());

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail());
    }

    // ---------- travelPlans: filed for approval before a trip happens ----------
    // Filed by anyone who can log a meeting (RM, Team Lead, Admin,
    // Superadmin — never Observer). Same read visibility as everywhere
    // else: RM own, Team Lead own + reports, Admin/Superadmin/Observer
    // everyone's.
    //
    // Approval is genuinely hierarchical, not just "Admin approves
    // everyone": a Team Lead approves their own reports' plans; Admin
    // and Superadmin approve EACH OTHER'S plans (there's no tier above
    // either of them, so they're paired as mutual approvers) as well as
    // anyone else's — that fallback also quietly resolves what would
    // otherwise be two gaps: a Team Lead has no manager of their own to
    // route through, and anyone whose managedBy is still unset has
    // nobody else to ask.
    match /travelPlans/{planId} {
      allow get, list: if canViewAll()
        || (isMember() && resource.data.rmEmail == callerEmail())
        || (isTeamLead() && isMyReport(resource.data.rmEmail));

      allow create: if canLog()
        && request.resource.data.rmEmail == callerEmail()
        && request.resource.data.destination is string
        && request.resource.data.destination.size() > 0
        && request.resource.data.fromDate is string
        && request.resource.data.toDate is string
        && request.resource.data.meetingsPlanned is number
        && request.resource.data.status == 'Pending';

      // The filer can still fix a typo while it's undecided; once it's
      // Approved or Rejected, only an approver can touch it further.
      allow update: if isAdminOrAbove()
        || (isTeamLead() && isMyReport(resource.data.rmEmail))
        || (canLog() && resource.data.rmEmail == callerEmail() && resource.data.status == 'Pending');

      allow delete: if isAdminOrAbove()
        || (canLog() && resource.data.rmEmail == callerEmail() && resource.data.status == 'Pending');
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
